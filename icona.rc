1 ICON "icona.ico"

1 VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004B0"
        BEGIN
            VALUE "CompanyName",      "Clooudy"
            VALUE "FileDescription",  "FluidWin"
            VALUE "FileVersion",      "1.0.1"
            VALUE "InternalName",     "FluidWin"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Clooudy - licenza MIT"
            VALUE "OriginalFilename", "FluidWin.exe"
            VALUE "ProductName",      "FluidWin"
            VALUE "ProductVersion",   "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0410, 1200
    END
END
